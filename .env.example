# Kollektverktyget - miljokonfiguration
# Kopiera till .env och justera vid behov.

# Katalog dar in-filer (Swish-rapport, kalender, KOB-export) lasas fran.
HAVEN_DATA_DIR=data

# Andamalskalender for aktuellt ar (ett blad per forsamling: DK/HE/HA/HO/ST/SA/VI).
HAVEN_KALENDER_FIL=2026 - Kollektandamal.xlsx

# SQLite-databas for arbetskostatus och idempotens.
HAVEN_DB=haven.db

# Bind-adress for webbtjansten (nas over Tailscale i homelabben).
HAVEN_HOST=0.0.0.0
HAVEN_PORT=8000
