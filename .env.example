# Kollektverktyget - miljökonfiguration
# Kopiera till .env och justera vid behov. Läses in automatiskt av app/config.py.

# Katalog där in-filer (Swish-rapport, kalender, KOB-export) läses från.
HAVEN_DATA_DIR=data

# Ändamålskalender för aktuellt år (ett blad per församling: DK/HE/HÄ/HÖ/ST/SÄ/VI).
# Måste matcha filnamnet i data-katalogen exakt (inklusive accenter).
HAVEN_KALENDER_FIL=2026 - Kollektändamål.xlsx

# SQLite-databas för arbetsköstatus och idempotens.
HAVEN_DB=haven.db

# Bind-adress för webbtjänsten (nås över Tailscale i homelabben).
HAVEN_HOST=0.0.0.0
HAVEN_PORT=8000
